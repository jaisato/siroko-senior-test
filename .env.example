# Copy to `.env` next to docker-compose.yaml and adjust. Every value has a
# development default in docker-compose.yaml, so `docker compose up` works
# without this file; it exists so that nothing real ever has to be typed into a
# versioned file.
#
# The application never connects as root: MYSQL_USER owns both the application
# database and the test database (`${MYSQL_DATABASE}_test`, created by
# docker/mysql/init on first start).

# Symfony environment for the php and worker containers (dev | prod)
APP_ENV=dev
# Any long random string. Required in prod; the dev/test .env files ship their own.
APP_SECRET=change_me_to_a_long_random_string

MYSQL_DATABASE=siroko_cart
MYSQL_USER=siroko
MYSQL_PASSWORD=siroko_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

# API tokens, `token:customerId` pairs separated by commas. Empty = the API is
# open (default); set it to require a token on every /v1 route.
API_TOKENS=

# Seconds a pending cart keeps its units reserved before cart:release-expired
# gives them back (the php, worker and scheduler services read it).
CART_RESERVATION_TTL=1800

# Host ports
NGINX_PORT=8080

# Bind-mount ownership for the dev image (match `id -u` / `id -g`)
UID=1000
GID=1000
