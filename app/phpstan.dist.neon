includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    # The oldest PHP composer.json accepts, not the one this machine happens to
    # run. `new Foo()->bar()` parses on 8.4 and is a syntax error on 8.3, so a
    # contributor on the newer runtime wrote one, every local gate passed, and
    # CI's 8.3 job was the first thing to see it.
    phpVersion: 80300
    paths:
        - src
        - tests
    excludePaths:
        # MySQL DDL kept verbatim from doctrine:migrations:diff.
        - src/Cart/Infrastructure/Persistence/Doctrine/Migrations
    tmpDir: var/cache/phpstan
    symfony:
        # Dumped by `bin/console cache:warmup --env=dev` (debug kernels write it).
        # The extension refuses to run without it, which is why `composer stan`
        # warms the cache first.
        containerXmlPath: var/cache/dev/Siroko_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
