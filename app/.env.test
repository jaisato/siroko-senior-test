# define your env variables for the test env here
KERNEL_CLASS='Siroko\Kernel'
APP_SECRET='test_secret_not_for_production'

# The suite runs against SQLite out of the box: tests/bootstrap.php creates the
# schema from the mapping. CI exports a MySQL DATABASE_URL instead (a real
# environment variable wins over this file) and runs the migrations first.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
