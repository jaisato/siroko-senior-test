<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Siroko\Cart\Domain\Entity\CartItem"
            table="cart_item"
    >

        <!-- A cart holds one line per product; the aggregate merges, the index settles races. -->
        <unique-constraints>
            <unique-constraint name="uniq_cartitem_cart_product" columns="cart_id,product_id"/>
        </unique-constraints>

        <id name="id" type="item_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <!-- How many units of the product this line reserves. -->
        <field name="quantity"
               column="quantity"
               type="quantity"
               nullable="false"
        />

        <!--
            The unit price this line settled at, copied by Cart::pay(). NULL
            while the cart is pending, when the line reads the product instead.
            Two plain columns rather than an embedded Price: an embeddable is
            never null in Doctrine, so a pending row would hydrate a Price whose
            typed properties were never set.
        -->
        <field name="paidAmount"
               column="paid_price_amount"
               type="decimal"
               precision="19"
               scale="4"
               nullable="true"
        />

        <field name="paidCurrency"
               column="paid_price_currency"
               type="string"
               length="3"
               nullable="true"
        />

        <many-to-one field="cart"
                     target-entity="Siroko\Cart\Domain\Entity\Cart"
                     inversed-by="items"
                     fetch="LAZY">
            <join-column name="cart_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="product"
                     target-entity="Siroko\Cart\Domain\Entity\Product"
                     fetch="LAZY">
            <join-column name="product_id" referenced-column-name="id" nullable="false" on-delete="RESTRICT"/>
        </many-to-one>

        <!-- cart_id is the leading column of the unique constraint, which serves the FK and the per-cart reads. -->
        <indexes>
            <index name="idx_cartitem_product" columns="product_id"/>
        </indexes>

    </entity>
</doctrine-mapping>
