<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Siroko\Cart\Domain\Entity\Cart"
            table="cart">

        <id name="id" type="cart_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <!-- The sweep that releases expired reservations reads by (status, expires_at). -->
        <indexes>
            <index name="idx_cart_status_expires" columns="status,expires_at"/>
            <!-- GET /v1/carts lists a customer's carts newest first. -->
            <index name="idx_cart_customer_created" columns="customer_id,created_at"/>
        </indexes>

        <!-- Fields -->
        <field name="status"
               column="status"
               type="cart_status"
               nullable="false"
        />

        <field name="createdAt" column="created_at" type="datetime_immutable" nullable="false"/>

        <!-- Set while pending; a paid or canceled cart reserves nothing. -->
        <field name="expiresAt" column="expires_at" type="datetime_immutable" nullable="true"/>

        <!--
            Null for a cart opened while the API ran without authentication.

            The column is utf8mb4_bin on MySQL (Version20260906170000), so it
            compares byte for byte like CustomerId does. It is not declared
            here on purpose: the schema tool would then emit the collation on
            SQLite too, where the name does not exist and CREATE TABLE fails.
        -->
        <field name="customerId" column="customer_id" type="customer_id" length="64" nullable="true"/>

        <one-to-many field="items"
                     target-entity="Siroko\Cart\Domain\Entity\CartItem"
                     mapped-by="cart"
                     orphan-removal="true"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <!-- opcional -->
            <order-by>
                <order-by-field name="id" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
